# Compose topology only. Copy to .env; run all commands from this directory.
BLOG_BIND_IP=127.0.0.1
BLOG_HTTP_PORT=18080
BLOG_ALLOWED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
BLOG_API_IMAGE=marker-hub-api:local
BLOG_WEB_IMAGE=marker-hub-web:local
# Both repositories must be siblings unless this path is overridden.
BLOG_WEB_CONTEXT=../../marker-hub-blog-vue
